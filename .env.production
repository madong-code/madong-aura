# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /
VITE_BASE = /

# 接口地址（由 nginx 反向代理到后端）
VITE_GLOB_API_URL = /adminapi

# art 壳原生变量（保留兼容）
VITE_API_URL = /adminapi

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS = none

# vue-router 的模式
VITE_ROUTER_HISTORY = hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING = true

# Delete console
VITE_DROP_CONSOLE = true
