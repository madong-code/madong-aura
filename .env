# 【通用】环境变量

#  版本号
VITE_VERSION = 3.0.2

# 端口号
VITE_PORT = 5500

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
# P4 起切换为 backend，菜单来自 madong GET /system/auth/user-menus
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4madong

# ===== madong 业务侧变量（与 madong-single 同名同义） =====

# 应用标题
VITE_APP_TITLE = MaDong-Aura

## 应用命名空间，用于缓存、store 等功能的前缀，确保隔离
VITE_APP_NAMESPACE = madong-aura

# 对 store 进行加密的密钥
VITE_APP_STORE_SECURE_KEY = please-replace-me-with-your-own-key

# 是否启用离线图标（true=使用本地 @iconify/json）
VITE_APP_ICON_OFFLINE = true

# 业务接口前缀（requestClient baseURL）
VITE_GLOB_API_URL = /adminapi

# 是否开启本地 Nitro Mock 服务（true=接口走 5320 mock；false=走真实后端 8500）
VITE_NITRO_MOCK = true
