# 【通用】环境变量
# art-admin = art-design-pro（UI 壳） + admin（业务层）
# 因此这里同时包含两套变量：VITE_* 为 art 原生，VITE_APP_*/VITE_GLOB_* 为 admin 业务层

# ---------------------------------------------------------------
# admin 业务层（#/core/* 运行时依赖，勿删）
# ---------------------------------------------------------------

# 应用标题
VITE_APP_TITLE=Madong 极速开发框架

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=madong-art

# 应用版本号（参与 preferences / store 的 namespace 计算）
VITE_APP_VERSION=3.0.2

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 是否启用离线图标
VITE_APP_ICON_OFFLINE=false

# ---------------------------------------------------------------
# art-design-pro UI 壳
# ---------------------------------------------------------------

#  版本号
VITE_VERSION = 3.0.2

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
# 注意：接入 admin 后端后应改为 backend
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro
