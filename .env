# 【通用】环境变量

# 版本号
VITE_VERSION = 3.0.1

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀
VITE_API_URL = /adminapi

# 是否启用 Token 自动刷新（true: 401 时自动刷新 token，false: 401 时直接退出）
VITE_TOKEN_REFRESH = true

# 权限模式（ frontend ｜ backend ）
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro

# 是否启用离线图标
# 图标前缀-提供给icon-picker选择的图标，这里的值建议和src/utils/load-icon.ts中引入的一致
VITE_APP_ICONIFY_PREFIX = ep,ant-design,carbon,ic,logos,lucide,ri

# 后端模式是否使用权限码接口
VITE_BACKEND_MODE_USE_CODE = true

# =============================================================================
# 静态资源配置（两种模式）
# =============================================================================

# 【模式 1】同域访问（默认，dist 部署到后端 public 目录）
# 静态资源使用相对路径，浏览器自动使用当前域名访问
VITE_STATIC_URL =

# 【模式 2】CDN 访问（静态资源使用对象存储或 CDN）
# 直接配置 CDN 域名
# VITE_STATIC_URL = https://cdn.example.com

