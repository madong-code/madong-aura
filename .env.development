# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀
VITE_API_URL = /adminapi

# 是否启用 Token 自动刷新（true: 401 时自动刷新 token，false: 401 时直接退出）
VITE_TOKEN_REFRESH = true

# Delete console
VITE_DROP_CONSOLE = false

# 本地开发代理的目标后端地址（仅开发环境生效，用于解决跨域）
VITE_API_PROXY_URL = http://127.0.0.1:8001



