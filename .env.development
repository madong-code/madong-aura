# 【开发】环境变量

# 应用部署基础路径
VITE_BASE_URL = /

# 业务 API 前缀（走 vite 代理）
VITE_GLOB_API_URL = /adminapi

# 开启本地 Nitro Mock（/adminapi /api /upload 代理到 5320，pnpm dev 自动拉起）
VITE_NITRO_MOCK = true

# 容器层 http 客户端基础路径（业务请求统一走 #/api 的 requestClient）
VITE_API_URL = /

# 代理目标（容器层少量原生接口用；主流量由上方 madong 代理规则处理）
VITE_API_PROXY_URL = http://localhost:5320

# Delete console
VITE_DROP_CONSOLE = false
