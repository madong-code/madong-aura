# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /
VITE_BASE = /

# 端口号
VITE_PORT = 3006

# ---------------------------------------------------------------
# 接口地址
# admin 业务层通过 #/core/request 读取 VITE_GLOB_API_URL，
# 走 vite proxy 转发到真实后端（见 vite.config.ts 的 server.proxy）
# ---------------------------------------------------------------
VITE_GLOB_API_URL = /adminapi

# art 壳原生变量（保留兼容，art 的 utils/http 使用）
VITE_API_URL = /
VITE_API_PROXY_URL = http://127.0.0.1:8500

# 后端真实地址（webman），vite proxy 的 target
VITE_PROXY_TARGET = http://127.0.0.1:8500

# Webman Push 配置
VITE_GLOB_ENABLE_WSS = true
VITE_GLOB_WSS_URL = ws://127.0.0.1:3501
VITE_GLOB_WSS_APPKEY = 60756ede2a9737a05384aad849e220f8

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS = false

# 是否注入全局loading
VITE_INJECT_APP_LOADING = true

# Delete console
VITE_DROP_CONSOLE = false
