# 【同域集成】环境变量
# 与 madong-single integrated 模式对齐：前端与后端同域部署，
# 静态资源挂载在 /admin/ 子路径，接口走相对路径 /adminapi（由同域网关转发）。
# hash 路由模式无需服务端 rewrite。

# 应用部署基础路径（子目录 /admin）
VITE_BASE_URL = /admin/

# 业务 API 前缀（同域相对路径）
VITE_GLOB_API_URL = /adminapi

# 同域部署不使用本地 mock
VITE_NITRO_MOCK = false

# 容器 http 客户端地址（同域相对路径）
VITE_API_URL = /

# Delete console
VITE_DROP_CONSOLE = true
